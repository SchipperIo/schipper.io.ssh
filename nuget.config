<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Schipper.* packages restore from the shared local feed one directory up.
    build.ps1 and build.sh pack into that folder. Inside the SDK container the
    feed is mounted at /tmp/nuget.cache, which is ../nuget.cache from the
    copied tree at /tmp/build.
  -->
  <packageSources>
    <clear />
    <add key="local" value="../nuget.cache" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Schipper.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
